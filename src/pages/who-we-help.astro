---
import Layout from '../components/layout/Layout.astro';
import PipeHeading from '../components/content/PipeHeading.astro';
import AudiencePill from '../components/content/AudiencePill.astro';
import CtaBand from '../components/content/CtaBand.astro';
import { getPage, required, section, slots } from '../content';

const page = getPage('who-we-help');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'who-we-help/hero.image');
const intro = section(page, 'intro', 'text');
const nsight = section(page, 'nsight360', 'fit');
const compliance = section(page, 'compliance-stat', 'figure');
const secondOpinion = section(page, 'second-opinion', 'fit');
const ophthal = section(page, 'ophthal360', 'fit');
const continuum = section(page, 'continuum', 'features');
const [stepScreening, stepDiagnosis, stepScale] = slots(continuum.items, 3, 'who-we-help/continuum.items');
const national = section(page, 'national-impact', 'split');
const nationalImage = required(national.image, 'who-we-help/national-impact.image');
const [nationalLead, nationalMore] = slots(national.paragraphs, 2, 'who-we-help/national-impact.paragraphs');
const globalReach = section(page, 'global-reach', 'divider');
const international = section(page, 'international-impact', 'split');
const internationalImage = required(international.image, 'who-we-help/international-impact.image');
const [internationalLead, internationalMore] = slots(international.paragraphs, 2, 'who-we-help/international-impact.paragraphs');
const finalCta = section(page, 'final-cta', 'cta');
const [contactCta] = slots(finalCta.ctas, 1, 'who-we-help/final-cta.ctas');
// Crop tuning of a "who it's for" photo, as the pill's inline style.
const pillStyle = (a: { photoPosition?: string; photoZoom?: number }) =>
  [a.photoPosition && `object-position: ${a.photoPosition};`, a.photoZoom && `transform: scale(${a.photoZoom});`]
    .filter(Boolean)
    .join(' ') || undefined;
---

<Layout
  title={page.title}
  description={page.description}
  currentPath="/who-we-help"
>

  <!-- SECTION 1 — HERO BAND -->
  <section class="relative overflow-hidden isolate bg-gradient-to-b from-brand-surface-blue to-white">
    <!-- Change 4: Fundus background wash — bleeds in from the right -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        class="absolute top-0 right-0 h-full"
        style="width:65%;object-fit:cover;object-position:center;opacity:0.13;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);mask-composite:intersect;"
        loading="eager"
      />
    </div>
    <div class="absolute inset-0 z-[1] pointer-events-none" aria-hidden="true" style="background:linear-gradient(to right,rgba(239,246,255,1) 0%,rgba(239,246,255,0.95) 25%,rgba(239,246,255,0.6) 45%,rgba(239,246,255,0.2) 65%,rgba(255,255,255,0) 100%);"></div>
    <svg class="absolute inset-0 w-full h-full opacity-[0.12] pointer-events-none z-[2]" aria-hidden="true">
      <defs>
        <pattern id="wwh-dots" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="#1E3A8A" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#wwh-dots)" />
    </svg>
    <div class="relative z-[3] max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-24 md:py-32">
      <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{hero.eyebrow}</p>
      <h1 class="mt-4 text-5xl md:text-6xl font-bold text-brand-ink leading-tight max-w-4xl">
        {hero.heading}
      </h1>
    </div>
  </section>

  <!-- SECTION 2 — INTRO STATEMENT -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20 text-center space-y-6">
      {intro.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p class="text-lg md:text-xl text-brand-body leading-relaxed" data-reveal>
        {p}
      </p></Fragment>)}
    </div>
  </section>

  <!-- SECTION 3 — NSIGHT360 BLOCK -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-6">
        <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{nsight.eyebrow}</p>
        <p class="text-sm text-brand-body italic">{nsight.tagline}</p>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink leading-tight max-w-3xl" data-reveal>
        {nsight.heading}
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-brand-body leading-relaxed" data-reveal>
        {nsight.body}
      </p>

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold text-brand-ink mb-4">{nsight.audiencesHeading}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {nsight.audiences.map((a, i) => <Fragment>{i > 0 && ' '}<AudiencePill label={a.label} photo={a.photo.src} photoAlt={a.photo.alt} photoStyle={pillStyle(a)} /></Fragment>)}
          </div>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-brand-ink mb-4">{nsight.benefitsHeading}</h3>
          <ul class="space-y-3 text-base text-brand-body leading-relaxed">
            {nsight.benefits.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-3"><span class="text-brand-primary mt-1">•</span><span>{b}</span></li></Fragment>)}
          </ul>
        </div>
      </div>
      <p class="mt-10 italic text-brand-body max-w-3xl">
        {nsight.closing}
      </p>
    </div>
  </section>

  <!-- SECTION 3.5 — COMPLIANCE STAT (visual break) -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-12 md:py-16">
      <div class="rounded-2xl overflow-hidden border border-brand-line bg-brand-surface-blue/40">
        <img
          src={compliance.image.src}
          alt={compliance.image.alt}
          class="w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 4 — 2ND OPINION BLOCK -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-6">
        <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{secondOpinion.eyebrow}</p>
        <p class="text-sm text-brand-body italic">{secondOpinion.tagline}</p>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink leading-tight max-w-3xl" data-reveal>
        {secondOpinion.heading}
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-brand-body leading-relaxed" data-reveal>
        {secondOpinion.body}
      </p>

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold text-brand-ink mb-4">{secondOpinion.audiencesHeading}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {secondOpinion.audiences.map((a, i) => <Fragment>{i > 0 && ' '}<AudiencePill label={a.label} photo={a.photo.src} photoAlt={a.photo.alt} photoStyle={pillStyle(a)} /></Fragment>)}
          </div>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-brand-ink mb-4">{secondOpinion.benefitsHeading}</h3>
          <ul class="space-y-3 text-base text-brand-body leading-relaxed">
            {secondOpinion.benefits.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-3"><span class="text-brand-primary mt-1">•</span><span>{b}</span></li></Fragment>)}
          </ul>
        </div>
      </div>
      <p class="mt-10 italic text-brand-body max-w-3xl">
        {secondOpinion.closing}
      </p>
    </div>
  </section>

  <!-- SECTION 5 — OPHTHAL360 BLOCK -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-6">
        <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{ophthal.eyebrow}</p>
        <p class="text-sm text-brand-body italic">{ophthal.tagline}</p>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink leading-tight max-w-3xl" data-reveal>
        {ophthal.heading}
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-brand-body leading-relaxed" data-reveal>
        {ophthal.body}
      </p>

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold text-brand-ink mb-4">{ophthal.audiencesHeading}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {ophthal.audiences.map((a, i) => <Fragment>{i > 0 && ' '}<AudiencePill label={a.label} photo={a.photo.src} photoAlt={a.photo.alt} photoStyle={pillStyle(a)} /></Fragment>)}
          </div>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-brand-ink mb-4">{ophthal.benefitsHeading}</h3>
          <ul class="space-y-3 text-base text-brand-body leading-relaxed">
            {ophthal.benefits.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-3"><span class="text-brand-primary mt-1">•</span><span>{b}</span></li></Fragment>)}
          </ul>
        </div>
      </div>
      <p class="mt-10 italic text-brand-body max-w-3xl">
        {ophthal.closing}
      </p>
    </div>
  </section>

  <!-- SECTION 6 — CONTINUUM OF CARE -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink leading-tight" data-reveal>
        {continuum.heading}
      </h2>
      <p class="mt-6 text-lg text-brand-body max-w-3xl mx-auto leading-relaxed" data-reveal>
        {continuum.intro}
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-3 relative" data-reveal-group>
        <!-- Step 1 -->
        <a href={stepScreening.href} class="flex flex-col items-center text-center p-4 rounded-xl hover:bg-brand-surface transition-colors group">
          <div class="w-16 h-16 rounded-full bg-brand-surface-blue text-brand-primary flex items-center justify-center group-hover:bg-brand-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/><path d="M11 8v6"/></svg>
          </div>
          <p class="mt-4 text-sm uppercase tracking-widest text-brand-muted font-semibold">{stepScreening.eyebrow}</p>
          <p class="mt-1 text-lg font-bold text-brand-primary">{stepScreening.title}</p>
          <p class="mt-3 text-sm text-brand-body leading-relaxed">{stepScreening.body}</p>
        </a>
        <!-- Step 2 -->
        <a href={stepDiagnosis.href} class="flex flex-col items-center text-center p-4 rounded-xl hover:bg-brand-surface transition-colors group">
          <div class="w-16 h-16 rounded-full bg-brand-surface-blue text-brand-primary flex items-center justify-center group-hover:bg-brand-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <p class="mt-4 text-sm uppercase tracking-widest text-brand-muted font-semibold">{stepDiagnosis.eyebrow}</p>
          <p class="mt-1 text-lg font-bold text-brand-primary">{stepDiagnosis.title}</p>
          <p class="mt-3 text-sm text-brand-body leading-relaxed">{stepDiagnosis.body}</p>
        </a>
        <!-- Step 3 -->
        <a href={stepScale.href} class="flex flex-col items-center text-center p-4 rounded-xl hover:bg-brand-surface transition-colors group">
          <div class="w-16 h-16 rounded-full bg-brand-surface-blue text-brand-primary flex items-center justify-center group-hover:bg-brand-primary group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <p class="mt-4 text-sm uppercase tracking-widest text-brand-muted font-semibold">{stepScale.eyebrow}</p>
          <p class="mt-1 text-lg font-bold text-brand-primary">{stepScale.title}</p>
          <p class="mt-3 text-sm text-brand-body leading-relaxed">{stepScale.body}</p>
        </a>
      </div>

      <p class="mt-12 text-lg text-brand-body leading-relaxed">
        {continuum.closing}
      </p>
    </div>
  </section>

  <!-- SECTION 7 — NATIONAL IMPACT (US) — Change 2 (NEW) -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 grid gap-12 md:grid-cols-2 items-center">
      <!-- US single hero photo (P2: one clean shot instead of the squeezed collage) -->
      <div class="rounded-2xl overflow-hidden shadow-[0_10px_30px_-10px_rgba(15,44,92,0.18)] aspect-[4/3]" data-reveal>
        <img
          src={nationalImage.src}
          alt={nationalImage.alt}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.18em] text-brand-primary font-bold mb-1" data-reveal>{national.eyebrow}</p>
        <PipeHeading level="h2" data-reveal>{national.heading}</PipeHeading>
        <h3 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink leading-tight" data-reveal>
          {national.subheading}
        </h3>
        <p class="mt-6 text-base md:text-lg text-brand-body leading-relaxed" data-reveal>
          {nationalLead}
        </p>
        <p class="mt-4 text-base md:text-lg text-brand-body leading-relaxed" data-reveal>
          {nationalMore}
        </p>
        <div class="mt-8 flex gap-3 flex-wrap" data-reveal>
          {(national.stats ?? []).map((stat, i) => <Fragment>{i > 0 && ' '}<div class="flex items-center gap-2.5 bg-brand-surface-blue border border-brand-line rounded-full px-4 py-2">
            <span class="text-xl font-extrabold text-brand-primary">{stat.value}</span>
            <span class="text-xs text-brand-muted font-medium leading-tight"><Fragment set:html={stat.label} /></span>
          </div></Fragment>)}
        </div>
      </div>
    </div>
  </section>

  <!-- DIVIDER — Our Global Reach -->
  <div class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-2">
      <div class="flex items-center gap-4">
        <span class="flex-1 h-px bg-brand-line"></span>
        <span class="text-[0.7rem] font-bold uppercase tracking-[0.2em] text-brand-muted whitespace-nowrap">{globalReach.heading}</span>
        <span class="flex-1 h-px bg-brand-line"></span>
      </div>
    </div>
  </div>

  <!-- SECTION 8 — INTERNATIONAL IMPACT (Pakistan) — Change 3 (renamed from Regional) -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 grid gap-12 md:grid-cols-2 items-center">
      <div class="order-2 md:order-1">
        <p class="text-xs uppercase tracking-[0.18em] text-brand-primary font-bold mb-1" data-reveal>{international.eyebrow}</p>
        <PipeHeading level="h2" data-reveal>{international.heading}</PipeHeading>
        <h3 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink leading-tight" data-reveal>
          {international.subheading}
        </h3>
        <p class="mt-6 text-base md:text-lg text-brand-body leading-relaxed" data-reveal>
          {internationalLead}
        </p>
        <p class="mt-4 text-base md:text-lg text-brand-body leading-relaxed" data-reveal>
          {internationalMore}
        </p>
        <div class="mt-8 flex gap-3 flex-wrap" data-reveal>
          {(international.stats ?? []).map((stat, i) => <Fragment>{i > 0 && ' '}<div class="flex items-center gap-2.5 bg-white border border-brand-line rounded-full px-4 py-2">
            <span class="text-xl font-extrabold text-brand-primary">{stat.value}</span>
            <span class="text-xs text-brand-muted font-medium leading-tight"><Fragment set:html={stat.label} /></span>
          </div></Fragment>)}
        </div>
      </div>
      <div class="order-1 md:order-2 rounded-2xl overflow-hidden shadow-[0_10px_30px_-10px_rgba(15,44,92,0.18)]" data-reveal>
        <img
          src={internationalImage.src}
          alt={internationalImage.alt}
          class="block w-full h-auto"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 8 — FINAL CTA -->
  <CtaBand image={finalCta.image?.src}>
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight" data-reveal>
        {finalCta.heading}
      </h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-white/90 leading-relaxed" data-reveal>
        {finalCta.body}
      </p>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {contactCta.label}
        </button>
      </div>
    </div>
  </CtaBand>

</Layout>
