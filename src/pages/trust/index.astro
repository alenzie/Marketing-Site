---
// Trust Center landing page. This is the route the new "Trust Center" nav tab points to
// (it replaces the packet's regulatory-compliance.html).
import Layout from '../../components/layout/Layout.astro';
import TrustHero from '../../components/trust/TrustHero.astro';
import TrustCloseout from '../../components/trust/TrustCloseout.astro';
import { DOCS, LANDING, BADGES, ITEMS } from '../../data/trust';

const panelOrder = LANDING.panelOrder;
---

<Layout
  title="Trust Center — Ophthalytics"
  description="Regulatory, quality, security and privacy at Ophthalytics. Our ISO 13485:2016 quality management system, controls and assurance activities protecting patients and data."
  footerVariant="minimal"
>
  <TrustHero title={LANDING.title} lede={LANDING.lede} meta={LANDING.meta} />

  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 pt-10 lg:pt-14 grid grid-cols-1 lg:grid-cols-[264px_minmax(0,1fr)] lg:gap-14 items-start">
    <aside class="hidden lg:flex sticky top-[100px] flex-col gap-7">
      <div>
        <div class="font-mono text-[10px] font-semibold uppercase tracking-[.16em] text-brand-muted px-3 mb-2.5">
          Trust Center
        </div>
        <nav class="flex flex-col gap-0.5">
          {panelOrder.map((key, i) => (
            <button
              type="button"
              data-panel-tab={key}
              class:list={[
                'block px-3 py-[9px] rounded-md text-[13.5px] leading-[1.35] text-left transition-colors',
                i === 0
                  ? 'bg-brand-navy text-white font-semibold'
                  : 'font-medium text-brand-body hover:bg-brand-surface',
              ]}
            >
              {LANDING.panels[key].label}
            </button>
          ))}
        </nav>
      </div>
      <div>
        <div class="font-mono text-[10px] font-semibold uppercase tracking-[.16em] text-brand-muted px-3 mb-2.5">
          Detailed Documentation
        </div>
        <nav class="flex flex-col gap-0.5">
          {DOCS.map((d) => (
            <a
              href={d.href}
              class="block px-3 py-[9px] rounded-md text-[13.5px] leading-[1.35] font-medium text-brand-body hover:bg-brand-surface transition-colors"
            >
              {d.label}
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <div class="min-w-0 max-w-[820px]">
      <!-- Document cards. Mobile only: below lg the sidebar (and its "Detailed
           Documentation" group) is hidden, so these are the only way to reach the three
           exhibits. On desktop they would duplicate the sidebar, so they are hidden.
           NEW CONTENT: the one-line descriptions are not Sultan's copy. -->
      <div class="mb-11 lg:hidden">
        <div class="font-mono text-[10px] font-semibold uppercase tracking-[.16em] text-brand-muted mb-4">
          Detailed documentation
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-3.5">
          {DOCS.map((d) => (
            <a
              href={d.href}
              class="flex flex-col gap-2 p-5 border border-brand-line rounded-xl bg-white hover:border-brand-cyan hover:bg-brand-surface transition-colors"
            >
              <span class="text-brand-primary flex">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
              </span>
              <span class="text-[15.5px] font-semibold text-brand-ink leading-[1.3]">{d.label}</span>
              <span class="text-[13.5px] leading-[1.6] text-brand-muted">{d.desc}</span>
              <span class="mt-0.5 text-[13px] font-semibold text-brand-primary">Read →</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Panels: tabbed on desktop, stacked on mobile (both rendered; CSS/JS decides) -->
      {panelOrder.map((key, i) => {
        const panel = LANDING.panels[key];
        return (
          <div
            data-panel={key}
            class:list={['lg:block', i === 0 ? '' : 'mt-14 lg:mt-0', i === 0 ? '' : 'lg:hidden']}
          >
            <h2 class="flex items-baseline gap-3 m-0 text-[28px] font-bold leading-[1.2] tracking-[-0.015em] text-brand-ink">
              <span class="block w-1 h-[0.8em] rounded-full bg-brand-primary flex-shrink-0"></span>
              <span>{panel.title}</span>
            </h2>
            <p class="mt-4 text-base leading-[1.7] text-brand-body text-pretty">{panel.lede}</p>

            {panel.badges && (
              <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-4">
                {BADGES.map((b) => (
                  <div
                    class:list={[
                      'flex gap-3.5 items-start p-[18px] rounded-xl border',
                      b.t === 'done' ? 'border-blue-100 bg-brand-surface-blue' : 'border-amber-200 bg-amber-50',
                    ]}
                  >
                    <div
                      class:list={[
                        'flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-white',
                        b.t === 'done' ? 'bg-brand-primary' : 'bg-status-warn',
                      ]}
                    >
                      {b.t === 'done' ? (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      ) : (
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                      )}
                    </div>
                    <div>
                      <div class="text-[14.5px] font-semibold text-brand-ink leading-[1.3]">{b.n}</div>
                      <div
                        class:list={[
                          'mt-1 font-mono text-[10px] uppercase tracking-[.14em] font-semibold',
                          b.t === 'done' ? 'text-brand-primary' : 'text-amber-700',
                        ]}
                      >
                        {b.s}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {panel.items && (
              <div class="mt-8 flex flex-col gap-5">
                {ITEMS.map((it) => (
                  <div class="flex gap-4 p-[22px] border border-brand-line rounded-xl bg-brand-surface">
                    <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-surface-blue border border-blue-100 flex items-center justify-center text-brand-primary">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2.5 flex-wrap">
                        <span class="text-base font-semibold text-brand-ink">{it.t}</span>
                        {it.pill && (
                          <span class="font-mono text-[10px] uppercase tracking-[.12em] font-semibold text-status-warn bg-amber-100 border border-amber-200 px-2 py-[3px] rounded-full">
                            {it.pill}
                          </span>
                        )}
                      </div>
                      <p class="mt-2 text-[15px] leading-[1.7] text-brand-body text-pretty">{it.d}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        );
      })}

      <TrustCloseout />
    </div>
  </div>

  <div class="h-[72px]"></div>
</Layout>

<script>
  // Desktop only: sidebar tabs swap which panel is shown. On mobile (< lg) every panel
  // is visible and stacked, so this script is a no-op there.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-panel-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (!isDesktop()) return;
      const key = tab.dataset.panelTab;
      panels.forEach((p) => p.classList.toggle('lg:hidden', p.dataset.panel !== key));
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('bg-brand-navy', on);
        t.classList.toggle('text-white', on);
        t.classList.toggle('font-semibold', on);
        t.classList.toggle('text-brand-body', !on);
        t.classList.toggle('font-medium', !on);
      });
    });
  });
</script>
