---
// [DERIVED COPY — founder review needed before launch]
import Layout from '../../components/layout/Layout.astro';
import PipeHeading from '../../components/content/PipeHeading.astro';
import CapabilityTile from '../../components/content/CapabilityTile.astro';
import AudienceCard from '../../components/content/AudienceCard.astro';
import CtaBand from '../../components/content/CtaBand.astro';

import { getPage, required, section, slots } from '../../content';

const page = getPage('ophthal360');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'ophthal360/hero.image');
const heroMedia = required(hero.media, 'ophthal360/hero.media');
const [demoCta, caseCta] = slots(hero.ctas, 2, 'ophthal360/hero.ctas');
const challenge = section(page, 'challenge', 'text');
const solution = section(page, 'solution', 'split');
const solutionAside = required(solution.aside, 'ophthal360/solution.aside');
const capabilities = section(page, 'capabilities', 'features');
// One built-in icon per capability slot.
const capabilityIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 14 20 9 15 4"/><path d="M4 20v-7a4 4 0 0 1 4-4h12"/></svg>`,
];
const capabilityTiles = slots(capabilities.items, 3, 'ophthal360/capabilities.items');
const whoItsFor = section(page, 'who-its-for', 'features');
// One built-in icon per audience slot.
const audienceIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20M7 7v10M17 7v10"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"/><path d="M14 9.3V1.99"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/></svg>`,
];
const audienceCards = slots(whoItsFor.items, 4, 'ophthal360/who-its-for.items');
const howItWorks = section(page, 'how-it-works', 'features');
const deploymentCase = section(page, 'deployment-case', 'split');
const deploymentCaseImage = required(deploymentCase.image, 'ophthal360/deployment-case.image');
const benefits = section(page, 'benefits', 'features');
const finalCta = section(page, 'final-cta', 'cta');
const [contactCta] = slots(finalCta.ctas, 1, 'ophthal360/final-cta.ctas');
---

<Layout
  title={page.title}
  description={page.description}
>
  <!-- SECTION 1 — HERO (dark) -->
  <section class="relative isolate bg-gradient-to-br from-brand-primary-dark to-brand-primary text-white overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img src={heroImage.src} alt={heroImage.alt} class="absolute top-0 right-0 h-full" style="width:65%;object-fit:cover;object-position:center;opacity:0.16;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);mask-composite:intersect;" loading="eager" decoding="async" />
    </div>
    <div class="absolute inset-0 opacity-15" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id="grid-ophthal" width="32" height="32" patternUnits="userSpaceOnUse">
            <path d="M 32 0 L 0 0 0 32" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-ophthal)"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28 grid gap-12 md:grid-cols-2 items-center">
      <div>
        <span class="inline-block rounded-full bg-brand-secondary/20 text-brand-secondary text-xs uppercase tracking-widest font-semibold px-3 py-1">
          {hero.eyebrow}
        </span>
        <h1 class="mt-5 text-5xl md:text-6xl font-bold leading-tight">{hero.heading}</h1>
        <p class="mt-3 text-2xl md:text-3xl font-semibold text-brand-secondary" data-reveal>
          {hero.subheading}
        </p>
        <p class="mt-6 text-lg text-white/90 leading-relaxed max-w-xl" data-reveal>
          {hero.body}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            data-open-modal={demoCta.modal}
            class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-6 py-3 rounded-md hover:bg-brand-surface transition"
          >
            {demoCta.label}
          </button>
          <a
            href={caseCta.href}
            class="inline-flex items-center justify-center border-2 border-white text-white font-semibold px-6 py-3 rounded-md hover:bg-white hover:text-brand-primary transition"
          >
            {caseCta.label}
          </a>
        </div>
      </div>
      <div class="flex justify-center">
        <div class="rounded-2xl overflow-hidden border border-white/15 ring-1 ring-white/10 shadow-2xl shadow-black/40">
          <img
            src={heroMedia.src}
            alt={heroMedia.alt}
            class="block w-full h-auto max-w-[560px]"
            width="1536"
            height="1024"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE CHALLENGE -->
  <section class="bg-brand-surface">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
        {' '}{challenge.eyebrow}{' '}
      </PipeHeading>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
        {challenge.heading}
      </h2>
      <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
        {challenge.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — WHAT IT DOES -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 grid gap-12 md:grid-cols-5 items-start">
      <div class="md:col-span-3">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
          {' '}{solution.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
          {solution.heading}
        </h2>
        <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {solution.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
        </div>
      </div>
      <div class="md:col-span-2 bg-brand-ink text-white rounded-2xl p-8">
        <p class="text-xs uppercase tracking-widest text-brand-secondary font-semibold">{solutionAside.eyebrow}</p>
        <h3 class="mt-3 text-2xl font-bold">{solutionAside.heading}</h3>
        <p class="mt-4 text-white/80 leading-relaxed">
          {solutionAside.body}
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — CAPABILITIES -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" class="justify-center" data-reveal>
          {' '}{capabilities.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{capabilities.heading}</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
        {capabilityTiles.map((c, i) => (
          <CapabilityTile title={c.title} body={required(c.body, 'ophthal360/capabilities.items.body')}>
            <span slot="icon" set:html={capabilityIcons[i]}></span>
          </CapabilityTile>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — WHO IT'S FOR -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" color="text-brand-ink" class="justify-center" data-reveal>
          {' '}{whoItsFor.heading}{' '}
        </PipeHeading>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
        {audienceCards.map((a, i) => (
          <AudienceCard title={a.title} body={required(a.body, 'ophthal360/who-its-for.items.body')}>
            <span slot="icon" set:html={audienceIcons[i]}></span>
          </AudienceCard>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6 — HOW IT WORKS -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink text-center" data-reveal>{howItWorks.heading}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-4" data-reveal-group>
        {howItWorks.items.map((s, i) => (
          <div class="bg-white border border-brand-line rounded-xl p-6">
            <span class="text-brand-primary font-bold text-4xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold text-brand-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-brand-body leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 7 — CASE IN PRACTICE -->
  <CtaBand id="deployment-case" image={deploymentCase.background?.src}>
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 grid gap-12 md:grid-cols-2 items-center">
      <div class="aspect-[4/3] rounded-2xl overflow-hidden border border-white/10">
        <img
          src={deploymentCaseImage.src}
          alt={deploymentCaseImage.alt}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <p class="text-sm uppercase tracking-widest text-brand-secondary font-semibold" data-reveal>{deploymentCase.eyebrow}</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold" data-reveal>
          {deploymentCase.heading}
        </h2>
        <div class="mt-6 space-y-5 text-lg text-white/90 leading-relaxed" data-reveal>
          {deploymentCase.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
        </div>
      </div>
    </div>
  </CtaBand>

  <!-- SECTION 8 — WHY -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink text-center" data-reveal>
        {benefits.heading}
      </h2>
      <div class="mt-12 grid gap-8 md:grid-cols-2 max-w-5xl mx-auto" data-reveal-group>
        {benefits.items.map((b) => (
          <div class="bg-brand-surface border border-brand-line rounded-xl p-6">
            <h3 class="text-xl font-bold text-brand-ink">{b.title}</h3>
            <p class="mt-2 text-base text-brand-body leading-relaxed">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 9 — FINAL CTA -->
  <CtaBand image={finalCta.image?.src}>
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight" data-reveal>{finalCta.heading}</h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-white/90 leading-relaxed" data-reveal>
        {finalCta.body}
      </p>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {contactCta.label}
        </button>
      </div>
    </div>
  </CtaBand>
</Layout>
