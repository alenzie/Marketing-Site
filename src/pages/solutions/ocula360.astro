---
import Layout from '../../components/layout/Layout.astro';
import PipeHeading from '../../components/content/PipeHeading.astro';
import CapabilityTile from '../../components/content/CapabilityTile.astro';
import CanvasHero from '../../components/canvas/CanvasHero.astro';
import OrbRingCanvas from '../../components/canvas/OrbRingCanvas.astro';
import RetinalIntelligenceCanvas from '../../components/canvas/RetinalIntelligenceCanvas.astro';
import CtaBand from '../../components/content/CtaBand.astro';

import { getPage, required, section, slots } from '../../content';

const page = getPage('ocula360');
const hero = section(page, 'hero', 'hero');
const heroMedia = required(hero.media, 'ocula360/hero.media');
const [demoCta, overviewCta] = slots(hero.ctas, 2, 'ocula360/hero.ctas');
const platform = section(page, 'platform', 'split');
const platformImage = required(platform.image, 'ocula360/platform.image');
const capabilities = section(page, 'capabilities', 'features');
// One built-in icon per capability slot.
const capabilityIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 10v6m11-11h-6M7 12H1m15.5-6.5l-4.2 4.2m-4.6 4.6L3.5 18.5m0-13l4.2 4.2m4.6 4.6l4.2 4.2"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
];
const capabilityTiles = slots(capabilities.items, 4, 'ocula360/capabilities.items');
const howItWorks = section(page, 'how-it-works', 'features');
const useCases = section(page, 'use-cases', 'features');
const approach = section(page, 'approach', 'split');
const approachImage = required(approach.image, 'ocula360/approach.image');
const [approachLead, approachMore] = slots(approach.paragraphs, 2, 'ocula360/approach.paragraphs');
const benefits = section(page, 'benefits', 'features');
const finalCta = section(page, 'final-cta', 'cta');
const [contactCta] = slots(finalCta.ctas, 1, 'ocula360/final-cta.ctas');
---

<Layout
  title={page.title}
  description={page.description}
>
  <!-- SECTION 1 — HERO (dark) -->
  <section class="relative isolate bg-gradient-to-br from-brand-primary-dark to-brand-primary text-white overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden hidden md:block" aria-hidden="true">
      <RetinalIntelligenceCanvas />
    </div>
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id="grid-ocula" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-ocula)"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28 grid gap-12 md:grid-cols-2 items-center">
      <div>
        <span class="inline-block rounded-full bg-white/10 text-white text-xs uppercase tracking-widest font-semibold px-3 py-1">
          {hero.eyebrow}
        </span>
        <h1 class="mt-5 text-5xl md:text-6xl font-bold leading-tight">{hero.heading}</h1>
        <p class="mt-3 text-2xl md:text-3xl font-semibold text-brand-secondary" data-reveal>
          {hero.subheading}
        </p>
        <p class="mt-6 text-lg text-white/90 leading-relaxed max-w-xl" data-reveal>
          {hero.body}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            data-open-modal={demoCta.modal}
            class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-6 py-3 rounded-md hover:bg-brand-surface transition"
          >
            {demoCta.label}
          </button>
          <button
            type="button"
            data-open-modal={overviewCta.modal}
            class="inline-flex items-center justify-center border-2 border-white text-white font-semibold px-6 py-3 rounded-md hover:bg-white hover:text-brand-primary transition"
          >
            {overviewCta.label}
          </button>
        </div>
      </div>
      <div class="relative">
        <div class="rounded-2xl overflow-hidden border border-brand-line shadow-xl">
          <img
            src={heroMedia.src}
            alt={heroMedia.alt}
            class="w-full h-auto block"
            loading="lazy"
            width="1264"
            height="843"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — WHAT IS OCULA360 -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20 text-center">
      <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" class="justify-center" data-reveal>
        {' '}{platform.eyebrow}{' '}
      </PipeHeading>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
        {platform.heading}
      </h2>
      <div class="mt-8 space-y-5 text-lg text-brand-body leading-relaxed text-left" data-reveal>
        {platform.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>
          {p}
        </p></Fragment>)}
        <p class="text-xl font-semibold text-brand-ink">
          {platform.closing}
        </p>
      </div>

      <figure class="mt-14 max-w-lg mx-auto" data-reveal>
        <div class="rounded-xl overflow-hidden border border-brand-line shadow-lg ring-1 ring-black/5">
          <img
            src={platformImage.src}
            alt={platformImage.alt}
            class="w-full h-auto block"
            loading="lazy"
            width="1264"
            height="843"
          />
        </div>
        <figcaption class="mt-3 text-sm text-brand-body">
          {platform.caption}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- SECTION 3 — CORE CAPABILITIES -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" class="justify-center" data-reveal>
          {' '}{capabilities.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
          {capabilities.heading}
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {capabilityTiles.map((c, i) => (
          <CapabilityTile title={c.title} body={required(c.body, 'ocula360/capabilities.items.body')}>
            <span slot="icon" set:html={capabilityIcons[i]}></span>
          </CapabilityTile>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — HOW IT WORKS -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{howItWorks.heading}</h2>
        <p class="mt-4 text-lg text-brand-body" data-reveal>{howItWorks.intro}</p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-4" data-reveal-group>
        {howItWorks.items.map((s, i) => (
          <div class="relative bg-white border border-brand-line rounded-xl p-6">
            <span class="text-brand-primary font-bold text-4xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold text-brand-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-brand-body leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — USE CASES -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{useCases.heading}</h2>
        <p class="mt-4 text-lg text-brand-body" data-reveal>
          {useCases.intro}
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
        {useCases.items.map((u) => (
          <div class="bg-white border border-brand-line rounded-2xl p-8 h-full flex flex-col">
            <h3 class="text-xl font-bold text-brand-ink">{u.title}</h3>
            <p class="mt-3 text-base text-brand-body leading-relaxed flex-1">{u.body}</p>
            <p class="mt-5 text-xs uppercase tracking-widest text-brand-primary font-semibold">
              {u.tag}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6 — HUMAN + AI -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 grid gap-12 md:grid-cols-2 items-center">
      <div class="flex justify-center">
        <img
          src={approachImage.src}
          alt={approachImage.alt}
          class="w-full max-w-[340px] h-auto"
        />
      </div>
      <div>
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
          {' '}{approach.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
          {approach.heading}
        </h2>
        <div class="mt-6 space-y-4 text-lg text-brand-body leading-relaxed" data-reveal>
          <p>{approachLead}</p>
          <p>
            {approachMore}
          </p>
        </div>
        <ul class="mt-6 space-y-3 text-base text-brand-body">
          {(approach.points ?? []).map((pt, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-3"><span class="font-semibold text-brand-ink min-w-[140px]">{pt.term}</span> {pt.body}</li></Fragment>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- SECTION 7 — WHY -->
  <CtaBand image={benefits.image?.src}>
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <h2 class="text-3xl md:text-4xl font-bold text-center" data-reveal>{benefits.heading}</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-2 max-w-5xl mx-auto" data-reveal-group>
        {benefits.items.map((b) => (
          <div>
            <h3 class="text-xl font-bold">{b.title}</h3>
            <p class="mt-2 text-base text-white/90 leading-relaxed">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </CtaBand>

  <!-- SECTION 8 — FINAL CTA -->
  <CtaBand image={finalCta.image?.src}>
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight" data-reveal>{finalCta.heading}</h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-white/90 leading-relaxed" data-reveal>
        {finalCta.body}
      </p>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {contactCta.label}
        </button>
      </div>
    </div>
  </CtaBand>
</Layout>
