---
// [DERIVED COPY — founder review needed before launch]
import Layout from '../../components/layout/Layout.astro';
import PipeHeading from '../../components/content/PipeHeading.astro';
import CapabilityTile from '../../components/content/CapabilityTile.astro';
import CtaBand from '../../components/content/CtaBand.astro';

import { getPage, required, section, slots } from '../../content';

const page = getPage('second-opinion');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'second-opinion/hero.image');
const heroMedia = required(hero.media, 'second-opinion/hero.media');
const [demoCta, integrateCta] = slots(hero.ctas, 2, 'second-opinion/hero.ctas');
const challenge = section(page, 'challenge', 'text');
const solution = section(page, 'solution', 'split');
const solutionAside = required(solution.aside, 'second-opinion/solution.aside');
const capabilities = section(page, 'capabilities', 'features');
// One built-in icon per capability slot.
const capabilityIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
];
const capabilityTiles = slots(capabilities.items, 3, 'second-opinion/capabilities.items');
const whoItsFor = section(page, 'who-its-for', 'audiences');
const howItIntegrates = section(page, 'how-it-integrates', 'features');
const benefits = section(page, 'benefits', 'features');
const finalCta = section(page, 'final-cta', 'cta');
const [contactCta] = slots(finalCta.ctas, 1, 'second-opinion/final-cta.ctas');
---

<Layout
  title={page.title}
  description={page.description}
>
  <!-- SECTION 1 — HERO -->
  <section class="relative overflow-hidden isolate bg-white border-b border-brand-line">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img src={heroImage.src} alt={heroImage.alt} class="absolute top-0 h-full" style="left:-22%;width:85%;object-fit:cover;object-position:center;opacity:0.14;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to left,transparent 0%,transparent 20%,black 45%,black 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to left,transparent 0%,transparent 20%,black 45%,black 100%);mask-composite:intersect;" loading="eager" decoding="async" />
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28 grid gap-12 md:grid-cols-2 items-center">
      <div>
        <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{hero.eyebrow}</p>
        <h1 class="mt-4 text-5xl md:text-6xl font-bold text-brand-ink leading-tight">{hero.heading}</h1>
        <p class="mt-3 text-2xl text-brand-primary" data-reveal>{hero.subheading}</p>
        <p class="mt-6 max-w-xl text-lg text-brand-body leading-relaxed" data-reveal>
          {hero.body}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            data-open-modal={demoCta.modal}
            class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold px-6 py-3 rounded-md hover:bg-brand-primary-dark transition"
          >
            {demoCta.label}
          </button>
          <a
            href={integrateCta.href}
            class="inline-flex items-center justify-center border-2 border-brand-primary text-brand-primary font-semibold px-6 py-3 rounded-md hover:bg-brand-primary hover:text-white transition"
          >
            {integrateCta.label}
          </a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-brand-line shadow-lg bg-brand-surface-blue">
        <img
          src={heroMedia.src}
          alt={heroMedia.alt}
          class="w-full h-auto block"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE CHALLENGE -->
  <section class="bg-brand-surface">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
        {' '}{challenge.eyebrow}{' '}
      </PipeHeading>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
        {challenge.heading}
      </h2>
      <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
        {challenge.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — THE SOLUTION -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 grid gap-12 md:grid-cols-5 items-start">
      <div class="md:col-span-3">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
          {' '}{solution.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
          {solution.heading}
        </h2>
        <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {solution.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
        </div>
      </div>
      <div class="md:col-span-2 bg-brand-primary text-white rounded-2xl p-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        <h3 class="mt-5 text-2xl font-bold">{solutionAside.heading}</h3>
        <p class="mt-3 text-white/80 leading-relaxed">
          {solutionAside.body}
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — CAPABILITIES -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" class="justify-center" data-reveal>
          {' '}{capabilities.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{capabilities.heading}</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
        {capabilityTiles.map((c, i) => (
          <CapabilityTile title={c.title} body={required(c.body, 'second-opinion/capabilities.items.body')}>
            <span slot="icon" set:html={capabilityIcons[i]}></span>
          </CapabilityTile>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — WHO IT'S FOR -->
  <section id="who-its-for" class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" color="text-brand-ink" class="justify-center" data-reveal>
          {' '}{whoItsFor.heading}{' '}
        </PipeHeading>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
        {whoItsFor.cards.map((a) => (
          <div class="bg-white rounded-lg p-6 text-center md:text-left">
            <img
              src={a.image.src}
              alt={a.image.alt}
              class="w-full h-44 object-cover rounded-lg mb-4"
              loading="lazy"
              decoding="async"
            />
            <h3 class="text-lg font-semibold text-brand-ink mb-2">{a.title}</h3>
            <p class="text-sm text-brand-body leading-relaxed">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6 — HOW IT INTEGRATES -->
  <section id="how-it-integrates" class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink text-center" data-reveal>
        {howItIntegrates.heading}
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
        {howItIntegrates.items.map((s, i) => (
          <div class="bg-white border border-brand-line rounded-xl p-6">
            <span class="text-brand-primary font-bold text-4xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold text-brand-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-brand-body leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 7 — WHY -->
  <CtaBand image={benefits.image?.src}>
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <h2 class="text-3xl md:text-4xl font-bold text-center" data-reveal>{benefits.heading}</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-2 max-w-5xl mx-auto" data-reveal-group>
        {benefits.items.map((b) => (
          <div>
            <h3 class="text-xl font-bold">{b.title}</h3>
            <p class="mt-2 text-base text-white/90 leading-relaxed">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </CtaBand>

  <!-- SECTION 8 — FINAL CTA -->
  <CtaBand image={finalCta.image?.src}>
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight" data-reveal>
        {finalCta.heading}
      </h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-white/90 leading-relaxed" data-reveal>
        {finalCta.body}
      </p>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {contactCta.label}
        </button>
      </div>
    </div>
  </CtaBand>
</Layout>
