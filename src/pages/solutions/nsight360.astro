---
// [DERIVED COPY — founder review needed before launch]
import Layout from '../../components/layout/Layout.astro';
import PipeHeading from '../../components/content/PipeHeading.astro';
import CapabilityTile from '../../components/content/CapabilityTile.astro';
import AudienceCard from '../../components/content/AudienceCard.astro';
import CtaBand from '../../components/content/CtaBand.astro';

import { getPage, required, section, slots } from '../../content';

const page = getPage('nsight360');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'nsight360/hero.image');
const heroMedia = required(hero.media, 'nsight360/hero.media');
const [demoCta, audienceCta] = slots(hero.ctas, 2, 'nsight360/hero.ctas');
const careGap = section(page, 'care-gap', 'text');
const solution = section(page, 'solution', 'split');
const capabilities = section(page, 'capabilities', 'features');
const whoItsFor = section(page, 'who-its-for', 'features');
// Built-in icon for an audience card without an image.
const audienceIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 21V9h6v12"/><path d="M12 3v6"/></svg>`;
const howItWorks = section(page, 'how-it-works', 'features');
const benefits = section(page, 'benefits', 'features');
const finalCta = section(page, 'final-cta', 'cta');
const [contactCta] = slots(finalCta.ctas, 1, 'nsight360/final-cta.ctas');
---

<Layout
  title={page.title}
  description={page.description}
>
  <!-- SECTION 1 — HERO -->
  <section class="relative overflow-hidden isolate bg-brand-surface-blue">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img src={heroImage.src} alt={heroImage.alt} class="absolute top-0 right-0 h-full" style="width:65%;object-fit:cover;object-position:center;opacity:0.13;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);mask-composite:intersect;" loading="eager" decoding="async" />
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28 grid gap-12 md:grid-cols-2 items-center">
      <div>
        <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{hero.eyebrow}</p>
        <h1 class="mt-4 text-5xl md:text-6xl font-bold text-brand-ink leading-tight">{hero.heading}</h1>
        <p class="mt-3 text-2xl text-brand-primary" data-reveal>{hero.subheading}</p>
        <p class="mt-6 max-w-xl text-lg text-brand-body leading-relaxed" data-reveal>
          {hero.body}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            data-open-modal={demoCta.modal}
            class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold px-6 py-3 rounded-md hover:bg-brand-primary-dark transition"
          >
            {demoCta.label}
          </button>
          <a
            href={audienceCta.href}
            class="inline-flex items-center justify-center border-2 border-brand-primary text-brand-primary font-semibold px-6 py-3 rounded-md hover:bg-brand-primary hover:text-white transition"
          >
            {audienceCta.label}
          </a>
        </div>
      </div>
      <div class="flex justify-center">
        <img
          src={heroMedia.src}
          alt={heroMedia.alt}
          width="600"
          height="600"
          class="w-full max-w-[480px] h-auto"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 2 — THE PROBLEM -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
        {' '}{careGap.eyebrow}{' '}
      </PipeHeading>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
        {careGap.heading}
      </h2>
      <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
        {careGap.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — WHAT NSIGHT360 DOES -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 grid gap-12 md:grid-cols-5 items-start">
      <div class="md:col-span-3">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
          {' '}{solution.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>
          {solution.heading}
        </h2>
        <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {solution.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>
            {p}
          </p></Fragment>)}
        </div>
      </div>
      <div class="md:col-span-2 bg-white rounded-2xl shadow-md p-8 space-y-6">
        {(solution.stats ?? []).map((stat, i) => <Fragment>{i > 0 && ' '}<div class={i > 0 ? 'border-t border-brand-line pt-6' : undefined}>
          <p class="text-5xl font-bold text-brand-primary">{stat.value}</p>
          <p class="mt-1 text-sm text-brand-body"><Fragment set:html={stat.label} /></p>
        </div></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — CAPABILITIES -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" class="justify-center" data-reveal>
          {' '}{capabilities.eyebrow}{' '}
        </PipeHeading>
        <h2 class="mt-4 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{capabilities.heading}</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
        {capabilities.items.map((c) => (
          <CapabilityTile title={c.title} body={required(c.body, 'nsight360/capabilities.items.body')}>
            <img
              slot="icon"
              src={required(c.image, 'nsight360/capabilities.items.image').src}
              alt={c.image?.alt}
              width="96"
              height="96"
              class="w-12 h-12 object-contain"
              loading="lazy"
              decoding="async"
            />
          </CapabilityTile>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — WHO IT'S FOR -->
  <section id="who-its-for" class="bg-brand-surface-blue">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <PipeHeading level="h2" color="text-brand-ink" class="justify-center" data-reveal>
          {' '}{whoItsFor.heading}{' '}
        </PipeHeading>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {whoItsFor.items.map((a) => (
          <AudienceCard title={a.title} body={required(a.body, 'nsight360/who-its-for.items.body')}>
            {a.image ? (
              <img
                slot="icon"
                src={a.image.src}
                alt={a.image.alt}
                width="96"
                height="96"
                class="w-full h-full object-contain"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span slot="icon" set:html={audienceIcon}></span>
            )}
          </AudienceCard>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6 — HOW IT WORKS -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink text-center" data-reveal>{howItWorks.heading}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-4" data-reveal-group>
        {howItWorks.items.map((s, i) => (
          <div class="bg-white border border-brand-line rounded-xl p-6">
            <span class="text-brand-primary font-bold text-4xl">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold text-brand-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-brand-body leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 7 — WHY -->
  <CtaBand image={benefits.image?.src}>
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <h2 class="text-3xl md:text-4xl font-bold text-center" data-reveal>{benefits.heading}</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-2 max-w-5xl mx-auto" data-reveal-group>
        {benefits.items.map((b) => (
          <div>
            <h3 class="text-xl font-bold">{b.title}</h3>
            <p class="mt-2 text-base text-white/90 leading-relaxed">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </CtaBand>

  <!-- SECTION 8 — FINAL CTA -->
  <CtaBand image={finalCta.image?.src}>
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight" data-reveal>
        {finalCta.heading}
      </h2>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-white/90 leading-relaxed" data-reveal>
        {finalCta.body}
      </p>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {contactCta.label}
        </button>
      </div>
    </div>
  </CtaBand>
</Layout>
