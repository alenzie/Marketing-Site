---
import Layout from '../../components/layout/Layout.astro';
import CtaBand from '../../components/content/CtaBand.astro';
import RetinalIntelligenceCanvas from '../../components/canvas/RetinalIntelligenceCanvas.astro';
import { getPage, required, section, slots } from '../../content';

const page = getPage('innovation-pipeline');
const hero = section(page, 'hero', 'hero');
const intro = section(page, 'intro', 'text');
const [introLead, introMore, introClosing] = slots(intro.paragraphs, 3, 'innovation-pipeline/intro.paragraphs');
const fourFront = section(page, 'four-front', 'split');
const cardio = section(page, 'cardiovascular', 'split');
const cardioImage = required(cardio.image, 'innovation-pipeline/cardiovascular.image');
const systemic = section(page, 'systemic-health', 'split');
const stayConnected = section(page, 'stay-connected', 'cta');
const [subscribeCta, contactCta] = slots(stayConnected.ctas, 2, 'innovation-pipeline/stay-connected.ctas');
const related = section(page, 'related', 'features');
---

<Layout
  title={page.title}
  description={page.description}
  noindex
>
  <!-- SECTION 1 — HERO -->
  <section class="relative isolate bg-gradient-to-br from-brand-primary-dark to-brand-primary overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden hidden md:block" aria-hidden="true">
      <RetinalIntelligenceCanvas />
    </div>
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28">
      <nav aria-label="Breadcrumb" class="text-sm text-white/60">
        <a href="/resources" class="hover:text-white">Resources</a>
        <span class="mx-2">/</span>
        <span class="text-white">{hero.breadcrumb}</span>
      </nav>
      <h1 class="mt-4 text-5xl md:text-6xl font-bold text-white leading-tight">
        {hero.heading}
      </h1>
      <p class="mt-6 max-w-3xl text-lg md:text-xl text-white/90 leading-relaxed" data-reveal>
        {hero.body}
      </p>
    </div>
  </section>

  <!-- SECTION 2 — INTRO -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
        <p>
          {introLead}
        </p>
        <p>
          {introMore}
        </p>
        <p>{introClosing}</p>
      </div>
    </div>
  </section>

  <!-- BLOCK A — 4FRONT360 -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20">
      <div class="grid gap-10 md:grid-cols-2 items-center">
        <div class="rounded-2xl aspect-[4/3] bg-gradient-to-br from-brand-surface-blue to-brand-secondary/20 flex items-center justify-center border border-brand-line">
          <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-primary">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
            <line x1="12" y1="18" x2="12" y2="18"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-brand-primary font-semibold" data-reveal>{fourFront.eyebrow}</p>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{fourFront.heading}</h2>
          <div class="mt-5 space-y-4 text-base text-brand-body leading-relaxed" data-reveal>
            {fourFront.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>
              {p}
            </p></Fragment>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK B — CARDIOVASCULAR -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20">
      <div class="grid gap-10 md:grid-cols-2 items-center">
        <div class="md:order-2 rounded-2xl aspect-[4/3] bg-gradient-to-br from-brand-accent/10 to-brand-primary/20 flex items-center justify-center border border-brand-line">
          <img
            src={cardioImage.src}
            alt={cardioImage.alt}
            width="273"
            height="269"
            class="max-w-[60%] max-h-[80%] object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="md:order-1">
          <p class="text-xs uppercase tracking-widest text-brand-primary font-semibold" data-reveal>{cardio.eyebrow}</p>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{cardio.heading}</h2>
          <div class="mt-5 space-y-4 text-base text-brand-body leading-relaxed" data-reveal>
            {cardio.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>
              {p}
            </p></Fragment>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK C — 270 DISEASES -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20">
      <div class="grid gap-10 md:grid-cols-2 items-center">
        <div class="rounded-2xl aspect-[4/3] bg-gradient-to-br from-brand-surface-blue to-brand-primary/20 flex items-center justify-center border border-brand-line">
          <svg viewBox="0 0 200 200" class="w-3/4 h-3/4" aria-hidden="true">
            <circle cx="100" cy="100" r="24" fill="none" stroke="#1E3A8A" stroke-width="2"/>
            <circle cx="100" cy="100" r="10" fill="#1E3A8A"/>
            {[0, 60, 120, 180, 240, 300].map((a) => (
              <line
                x1="100"
                y1="100"
                x2={100 + 70 * Math.cos((a * Math.PI) / 180)}
                y2={100 + 70 * Math.sin((a * Math.PI) / 180)}
                stroke="#3B5BBF"
                stroke-width="1.5"
                stroke-dasharray="4 4"
              />
            ))}
            {[0, 60, 120, 180, 240, 300].map((a) => (
              <circle
                cx={100 + 80 * Math.cos((a * Math.PI) / 180)}
                cy={100 + 80 * Math.sin((a * Math.PI) / 180)}
                r="10"
                fill="#EFF6FF"
                stroke="#1E3A8A"
                stroke-width="1.5"
              />
            ))}
          </svg>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-brand-primary font-semibold" data-reveal>{systemic.eyebrow}</p>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold text-brand-ink" data-reveal>{systemic.heading}</h2>
          <div class="mt-5 space-y-4 text-base text-brand-body leading-relaxed" data-reveal>
            {systemic.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>
              {p}
            </p></Fragment>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — STAY CONNECTED -->
  <CtaBand image={stayConnected.image?.src}>
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold" data-reveal>{stayConnected.heading}</h2>
      <p class="mt-5 text-lg text-white/90 max-w-2xl mx-auto leading-relaxed" data-reveal>
        {stayConnected.body}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center" data-reveal>
        <a
          href={subscribeCta.href}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-6 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {subscribeCta.label}
        </a>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center border-2 border-white text-white font-semibold px-6 py-3 rounded-md hover:bg-white hover:text-brand-primary transition"
        >
          {contactCta.label}
        </button>
      </div>
    </div>
  </CtaBand>

  <!-- SECTION 5 — RELATED RESOURCES -->
  <section class="bg-brand-surface">
    <div class="max-w-5xl mx-auto px-6 md:px-8 lg:px-12 py-16">
      <h2 class="text-xl font-semibold text-brand-ink text-center" data-reveal>{related.heading}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2" data-reveal-group>
        {related.items.map((r, i) => <Fragment>{i > 0 && ' '}<a href={r.href} class="bg-white border border-brand-line rounded-xl p-6 hover:shadow-lg transition-all">
          <p class="text-xs uppercase tracking-widest text-brand-primary font-semibold">{r.eyebrow}</p>
          <h3 class="mt-2 text-lg font-bold text-brand-ink">{r.title} →</h3>
          <p class="mt-2 text-sm text-brand-body">{r.body}</p>
        </a></Fragment>)}
      </div>
    </div>
  </section>
</Layout>
