---
import Layout from '../../components/layout/Layout.astro';
import ResourceCard from '../../components/content/ResourceCard.astro';

import { getPage, required, section } from '../../content';

const page = getPage('newsroom');
const hero = section(page, 'hero', 'hero');
const heroMedia = required(hero.media, 'newsroom/hero.media');
const news = section(page, 'news', 'resources');
const related = section(page, 'related', 'features');
---

<Layout
  title={page.title}
  description={page.description}
>
  <!-- SECTION 1 — HERO -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20 grid gap-10 md:grid-cols-2 items-center">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-brand-muted">
          <a href="/resources" class="hover:text-brand-primary">Resources</a>
          <span class="mx-2">/</span>
          <span class="text-brand-ink">{hero.breadcrumb}</span>
        </nav>
        <h1 class="mt-4 text-4xl md:text-5xl font-bold text-brand-ink leading-tight">
          {hero.heading}
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-brand-body leading-relaxed" data-reveal>
          {hero.body}
        </p>
      </div>
      <div class="relative" data-reveal>
        <img src={heroMedia.src} alt={heroMedia.alt} class="w-full rounded-2xl shadow-lg ring-1 ring-black/5 object-cover" loading="eager" decoding="async" />
      </div>
    </div>
  </section>

  <!-- SECTION 2 — NEWS GRID -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {news.cards.map((a) => (
          <div class="relative h-full">
            <ResourceCard
              thumbnail={a.thumbnail?.src}
              category={a.category}
              categoryColor={a.categoryColor}
              title={a.title}
              excerpt={a.excerpt}
              link={a.href}
            />
            <p class="absolute bottom-4 right-5 text-xs text-brand-muted">{a.date}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — RELATED RESOURCES -->
  <section class="bg-brand-surface">
    <div class="max-w-5xl mx-auto px-6 md:px-8 lg:px-12 py-16">
      <h2 class="text-xl font-semibold text-brand-ink text-center" data-reveal>{related.heading}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2" data-reveal-group>
        {related.items.map((r, i) => <Fragment>{i > 0 && ' '}<a href={r.href} class="bg-white border border-brand-line rounded-xl p-6 hover:shadow-lg transition-all">
          <p class="text-xs uppercase tracking-widest text-brand-primary font-semibold">{r.eyebrow}</p>
          <h3 class="mt-2 text-lg font-bold text-brand-ink">{r.title} →</h3>
          <p class="mt-2 text-sm text-brand-body">{r.body}</p>
        </a></Fragment>)}
      </div>
    </div>
  </section>
</Layout>
