---
import Layout from '../../components/layout/Layout.astro';
import PipeHeading from '../../components/content/PipeHeading.astro';
import ResourceCard from '../../components/content/ResourceCard.astro';

import { getPage, required, section } from '../../content';

const page = getPage('resources');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'resources/hero.image');
const browse = section(page, 'browse', 'features');
const featured = section(page, 'featured-research', 'split');
const featuredImage = required(featured.image, 'resources/featured-research.image');
const featuredLink = required(featured.link, 'resources/featured-research.link');
const latest = section(page, 'latest', 'resources');
---

<Layout
  title={page.title}
  description={page.description}
>
  <!-- SECTION 1 — HERO -->
  <section class="relative overflow-hidden isolate bg-brand-surface-blue">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img src={heroImage.src} alt={heroImage.alt} class="absolute top-0 right-0 h-full" style="width:65%;object-fit:cover;object-position:center;opacity:0.13;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);mask-composite:intersect;" loading="eager" decoding="async" />
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28">
      <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">{hero.eyebrow}</p>
      <h1 class="mt-3 text-5xl md:text-6xl font-bold text-brand-ink leading-tight">
        {hero.heading}
      </h1>
      <p class="mt-6 max-w-2xl text-lg md:text-xl text-brand-body leading-relaxed" data-reveal>
        {hero.body}
      </p>
    </div>
  </section>

  <!-- SECTION 2 — BROWSE BY CATEGORY (compact pills) -->
  <section class="bg-white border-b border-brand-line">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-8">
      <div class="flex flex-wrap items-center gap-3" data-reveal-group>
        <span class="text-sm font-semibold text-brand-muted mr-1">{browse.heading}</span>
        {browse.items.map((cat) => (
          <a
            href={cat.href}
            class="inline-flex items-center gap-2 rounded-full border border-brand-line bg-white px-4 py-2 text-sm font-semibold text-brand-ink hover:border-brand-primary hover:text-brand-primary transition-colors"
          >
            <img src={required(cat.image, 'resources/browse.items.image').src} alt={cat.image?.alt} width="20" height="20" class="w-5 h-5 object-contain" loading="lazy" />
            {cat.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — FEATURED RESEARCH -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <PipeHeading level="h2" size="text-sm uppercase tracking-widest" color="text-brand-primary" data-reveal>
        {' '}{featured.eyebrow}{' '}
      </PipeHeading>
      <div class="mt-8 grid gap-8 md:grid-cols-5 items-center bg-white rounded-2xl border border-brand-line overflow-hidden" data-reveal>
        <div class="md:col-span-2">
          <img
            src={featuredImage.src}
            alt={featuredImage.alt}
            class="w-full h-full object-cover aspect-[3/4] md:aspect-auto"
            loading="lazy"
          />
        </div>
        <div class="md:col-span-3 p-6 md:p-10">
          <span class="inline-block rounded-full bg-brand-primary/10 text-brand-primary text-xs uppercase tracking-widest font-semibold px-3 py-1">
            {featured.badge}
          </span>
          <h3 class="mt-4 text-2xl md:text-3xl font-bold text-brand-ink leading-snug">
            {featured.heading}
          </h3>
          <p class="mt-3 text-sm text-brand-muted">
            {featured.subheading}
          </p>
          {featured.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p class="mt-4 text-base text-brand-body leading-relaxed">
            {p}
          </p></Fragment>)}
          <a
            href={featuredLink.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 text-brand-primary font-semibold hover:gap-3 transition-all"
          >
            {featuredLink.label}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — LATEST (mixed-content feed) -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20">
      <PipeHeading level="h2" data-reveal>{latest.heading}</PipeHeading>
      <p class="mt-4 max-w-3xl text-lg text-brand-body leading-relaxed" data-reveal>
        {latest.intro}
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {latest.cards.map((item) => (
          <ResourceCard
            categoryColor={item.categoryColor}
            category={item.category}
            title={item.title}
            excerpt={item.excerpt}
            link={item.href}
            thumbnail={item.thumbnail?.src}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
