---
import Layout from '../../../components/layout/Layout.astro';
import CtaBand from '../../../components/content/CtaBand.astro';
import { getPage, richRuns, section, slots } from '../../../content';

const page = getPage('article-bridging-the-gap');
const hero = section(page, 'hero', 'hero');
const article = section(page, 'article', 'article');
const cta = section(page, 'cta', 'cta');
const [modalCta, linkCta] = slots(cta.ctas, 2, 'article-bridging-the-gap/cta.ctas');
---

<Layout title={page.title} description={page.description}>
  <!-- HERO -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20">
      <nav aria-label="Breadcrumb" class="text-sm text-brand-muted">
        <a href="/resources" class="hover:text-brand-primary">Resources</a>
        <span class="mx-2">/</span>
        <a href="/resources/articles" class="hover:text-brand-primary">Articles</a>
        <span class="mx-2">/</span>
        <span class="text-brand-ink">{hero.breadcrumb}</span>
      </nav>
      <span class="mt-5 inline-block rounded-full bg-brand-primary/10 text-brand-primary text-xs uppercase tracking-widest font-semibold px-3 py-1">
        {hero.eyebrow}
      </span>
      <h1 class="mt-4 text-3xl md:text-5xl font-bold text-brand-ink leading-tight">
        {hero.heading}
      </h1>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-brand-body">
        <span class="font-semibold text-brand-ink">{article.author}</span>
        <span class="text-brand-muted">{article.authorRole}</span>
        <span class="text-brand-muted">·</span>
        <span class="text-brand-muted">{article.date}</span>
      </div>
    </div>
  </section>

  <!-- ARTICLE BODY -->
  <article class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 pt-12 md:pt-16">
      <img
        src={article.cover.src}
        alt={article.cover.alt}
        width="1144"
        height="644"
        class="w-full rounded-xl border border-brand-line"
      />
    </div>
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20 prose-content">
      <p class="lead text-xl md:text-2xl text-brand-ink font-medium leading-snug">
        {article.lead}
      </p>

      {article.body.map((node, i) => <Fragment>{i > 0 && ' '}{node.type === 'heading' ? (
        node.level === 2 ? <h2>{node.text}</h2> : <h3>{node.text}</h3>
      ) : node.type === 'paragraph' ? (
        <p>
          {richRuns(node.text).map((r) => (r.tag === 'text' ? r.text : r.tag === 'strong' ? <strong>{r.text}</strong> : r.tag === 'em' ? <em>{r.text}</em> : r.tag === 'br' ? <br /> : <a href={r.href} target={r.target} rel={r.rel} class={r.class}>{r.text}</a>))}
        </p>
      ) : node.type === 'list' ? (
        <Fragment>{node.intro && <Fragment><p>{node.intro}</p>{' '}</Fragment>}<ul>
          {node.items.map((item, j) => <Fragment>{j > 0 && ' '}<li>{richRuns(item).map((r) => (r.tag === 'text' ? r.text : r.tag === 'strong' ? <strong>{r.text}</strong> : r.tag === 'em' ? <em>{r.text}</em> : r.tag === 'br' ? <br /> : <a href={r.href} target={r.target} rel={r.rel} class={r.class}>{r.text}</a>))}</li></Fragment>)}
        </ul></Fragment>
      ) : node.type === 'quote' ? (
        <blockquote class="border-l-4 border-brand-primary pl-6 my-10 text-xl md:text-2xl font-semibold text-brand-ink leading-snug not-italic">
          {node.text}
        </blockquote>
      ) : node.type === 'rule' ? (
        <hr class="my-12 border-brand-line" />
      ) : (
        <figure>
          <img src={node.image.src} alt={node.image.alt} class="w-full rounded-xl border border-brand-line" loading="lazy" />
          {node.caption && <figcaption class="mt-3 text-sm text-brand-muted">{node.caption}</figcaption>}
        </figure>
      )}</Fragment>)}

      <hr class="my-12 border-brand-line" />

      <p class="text-sm text-brand-muted">
        {article.source.text}
        <a href={article.source.link.href} target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">
          {article.source.link.label}
        </a>.
      </p>
    </div>
  </article>

  <!-- CTA -->
  <CtaBand image={cta.image?.src}>
    <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 py-16 md:py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold leading-tight" data-reveal>
        {cta.heading}
      </h2>
      <p class="mt-5 max-w-2xl mx-auto text-lg text-white/90 leading-relaxed" data-reveal>
        {cta.body}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center" data-reveal>
        <button
          type="button"
          data-open-modal={modalCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {modalCta.label}
        </button>
        <a
          href={linkCta.href}
          class="inline-flex items-center justify-center border-2 border-white text-white font-semibold px-8 py-3 rounded-md hover:bg-white hover:text-brand-primary transition"
        >
          {linkCta.label}
        </a>
      </div>
    </div>
  </CtaBand>
</Layout>

<style>
  .prose-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-brand-ink, #0F172A);
    line-height: 1.2;
  }
  .prose-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-brand-ink, #0F172A);
    line-height: 1.3;
  }
  .prose-content :global(p) {
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #334155;
  }
  .prose-content :global(.lead) {
    margin-bottom: 2rem;
    color: #0F172A;
    font-size: 1.375rem;
    line-height: 1.5;
  }
  .prose-content :global(ul) {
    margin: 1rem 0 1.25rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-content :global(li) {
    margin: 0.4rem 0;
    line-height: 1.7;
    color: #334155;
  }
  .prose-content :global(strong) {
    color: #0F172A;
    font-weight: 600;
  }
  .prose-content :global(a) {
    color: #1E3A8A;
    text-decoration: underline;
  }
  .prose-content :global(blockquote) {
    margin: 2rem 0;
  }
</style>
