---
import Layout from '../components/layout/Layout.astro';
import PipeHeading from '../components/content/PipeHeading.astro';
import TeamCard from '../components/content/TeamCard.astro';
import Modal from '../components/interactive/Modal.astro';
import CtaBand from '../components/content/CtaBand.astro';
import { getPage, required, section, slots } from '../content';

const page = getPage('about');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'about/hero.image');
const story = section(page, 'story', 'text');
const mission = section(page, 'mission', 'text');
const vision = section(page, 'vision', 'text');
const leadership = section(page, 'leadership', 'people');
const scientificAdvisors = section(page, 'scientific-advisors', 'people');
const businessAdvisors = section(page, 'business-advisors', 'people');
const joinUs = section(page, 'join-us', 'cta');
const [joinCta] = slots(joinUs.ctas, 1, 'about/join-us.ctas');
// People with a bio get a "Read Bio" modal, rendered at the end of the page.
const bios = leadership.people.flatMap((person) => (person.bio ? [{ person, bio: person.bio }] : []));
---

<Layout
  title={page.title}
  description={page.description}
>

  <!-- SECTION 1 — HERO BAND -->
  <section class="relative overflow-hidden isolate bg-gradient-to-b from-brand-surface-blue to-white">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img src={heroImage.src} alt={heroImage.alt} class="absolute top-0 right-0 h-full" style="width:65%;object-fit:cover;object-position:center;opacity:0.13;-webkit-mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);-webkit-mask-composite:source-in;mask-image:linear-gradient(to bottom,transparent 0%,black 15%,black 85%,transparent 100%),linear-gradient(to right,transparent 0%,transparent 5%,black 40%,black 100%);mask-composite:intersect;" loading="eager" decoding="async" />
    </div>
    <svg class="absolute inset-0 w-full h-full opacity-[0.12] pointer-events-none" aria-hidden="true">
      <defs>
        <pattern id="about-dots" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="#1E3A8A" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#about-dots)" />
    </svg>
    <div class="relative max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-24 md:py-32">
      <PipeHeading level="h1" size="text-5xl md:text-6xl">
        {' '}{hero.heading}{' '}
      </PipeHeading>
    </div>
  </section>

  <!-- SECTION 2 — OUR STORY / MISSION / VISION -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 space-y-16">
      <div>
        <PipeHeading level="h2" size="text-2xl md:text-3xl" data-reveal>{story.heading}</PipeHeading>
        <div class="mt-5 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {story.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
        </div>
      </div>

      <div>
        <PipeHeading level="h2" size="text-2xl md:text-3xl" data-reveal>{mission.heading}</PipeHeading>
        {mission.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p class="mt-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {p}
        </p></Fragment>)}
      </div>

      <div>
        <PipeHeading level="h2" size="text-2xl md:text-3xl" data-reveal>{vision.heading}</PipeHeading>
        {vision.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p class="mt-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {p}
        </p></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 3 — LEADERSHIP -->
  <section id="leadership" class="bg-brand-surface-blue scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="text-center">
        <PipeHeading level="h2" class="justify-center" data-reveal>{leadership.heading}</PipeHeading>
      </div>
      <div class="mt-12 grid gap-10 max-w-4xl mx-auto" data-reveal-group>
        {leadership.people.map((person, i) => <Fragment>{i > 0 && ' '}<TeamCard
          name={person.name}
          role={person.role}
          headshot={person.headshot?.src}
          bioModal={person.bio?.modal}
        /></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 4 — SCIENTIFIC ADVISORY BOARD -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="text-center">
        <PipeHeading level="h2" class="justify-center" data-reveal>{scientificAdvisors.heading}</PipeHeading>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3 max-w-6xl mx-auto" data-reveal-group>
        {scientificAdvisors.people.map((a) => (
          <TeamCard size="sm" name={a.name} role={a.role} headshot={a.headshot?.src} />
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — BUSINESS ADVISORY BOARD -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="text-center">
        <PipeHeading level="h2" class="justify-center" data-reveal>{businessAdvisors.heading}</PipeHeading>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3" data-reveal-group>
        {businessAdvisors.people.map((a) => (
          <TeamCard size="sm" name={a.name} role={a.role} headshot={a.headshot?.src} />
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 6 — JOIN US (Change 5: converted to washed CtaBand) -->
  <CtaBand image={joinUs.image?.src}>
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <PipeHeading level="h2" color="text-white" barColor="bg-brand-secondary" data-reveal>{joinUs.heading}</PipeHeading>
      <p class="mt-6 max-w-2xl text-lg text-white/90 leading-relaxed" data-reveal>
        {joinUs.body}
      </p>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={joinCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {joinCta.label}
        </button>
      </div>
    </div>
  </CtaBand>

  <!-- BIO MODALS -->
  {bios.map(({ person, bio }, i) => <Fragment>{i > 0 && ' '}<Modal name={bio.modal} labelledBy={`${bio.modal}-title`} size="lg">
    <div class="flex flex-col items-center">
      <img
        src={person.headshot?.src}
        alt={person.headshot?.alt}
        class="w-28 h-28 rounded-full object-cover border-4 border-white shadow-md"
      />
      <h2 id={`${bio.modal}-title`} class="mt-5 text-2xl md:text-3xl font-bold text-brand-ink text-center">
        {person.name}
      </h2>
      <p class="mt-1 text-brand-primary font-semibold">{person.role}</p>
      <p class="mt-1 italic text-brand-primary text-sm">{bio.tagline}</p>
    </div>
    <div class="mt-6 space-y-4 text-base text-brand-body leading-relaxed">
      {bio.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>
        {p}
      </p></Fragment>)}
    </div>
  </Modal></Fragment>)}

</Layout>
