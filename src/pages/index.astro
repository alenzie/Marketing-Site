---
import Layout from '../components/layout/Layout.astro';
import PipeHeading from '../components/content/PipeHeading.astro';
import CapabilityTile from '../components/content/CapabilityTile.astro';
import AudienceCard from '../components/content/AudienceCard.astro';
import TestimonialFeature from '../components/content/TestimonialFeature.astro';
import ResourceCard from '../components/content/ResourceCard.astro';
import CtaBand from '../components/content/CtaBand.astro';
import { getPage, required, section, slots } from '../content';

const page = getPage('home');
const hero = section(page, 'hero', 'hero');
const heroImage = required(hero.image, 'home/hero.image');
const [demoCta, exploreCta] = slots(hero.ctas, 2, 'home/hero.ctas');
// #2 — Post-event recap promo shown at the bottom of the hero (amaros.ai-style).
// The "Event Recap" button is a link only when `promo.url` is set; clear it to drop the link.
const speakerEvent = required(hero.promo, 'home/hero.promo');
const partners = section(page, 'partners', 'partners');
const beyond = section(page, 'beyond-the-eye', 'split');
const beyondImage = required(beyond.image, 'home/beyond-the-eye.image');
const flagship = section(page, 'flagship', 'showcase');
const [flagshipLead, flagshipMore] = slots(flagship.flagship.paragraphs, 2, 'home/flagship.flagship.paragraphs');
const [tileDetect, tileDrss, tileExplain] = slots(flagship.tiles, 3, 'home/flagship.tiles');
const products = section(page, 'products', 'products');
const [ocula, nsight, secondOpinion, ophthal] = slots(products.cards, 4, 'home/products.cards');
const whoWeHelp = section(page, 'who-we-help', 'audiences');
const [audPrimary, audOptometry, audInsurance, audPharma] = slots(whoWeHelp.cards, 4, 'home/who-we-help.cards');
const testimonial = section(page, 'testimonial', 'testimonial');
const insights = section(page, 'insights', 'resources');
const insightsLink = required(insights.link, 'home/insights.link');
const closing = section(page, 'closing', 'text');
const finalCta = section(page, 'final-cta', 'cta');
const [contactCta] = slots(finalCta.ctas, 1, 'home/final-cta.ctas');
---

<Layout
  title={page.title}
  description={page.description}
  currentPath="/"
>

  <!-- SECTION 1 — HERO (image-backed, full-bleed with bottom feather) -->
  <section class="relative bg-white overflow-hidden isolate">
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <img
        src={heroImage.src}
        alt={heroImage.alt}
        class="absolute inset-0 w-full h-full object-cover object-center md:object-right"
        loading="eager"
        style="-webkit-mask-image: linear-gradient(to bottom, black 0%, black 65%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, black 65%, transparent 100%);"
      />
    </div>
    <div
      class="absolute inset-0 z-[1] pointer-events-none"
      aria-hidden="true"
      style="background: linear-gradient(to right, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.82) 30%, rgba(255,255,255,0.40) 55%, rgba(255,255,255,0.10) 75%, rgba(255,255,255,0) 100%);"
    ></div>
    <div class="relative z-[2] max-w-7xl mx-auto px-6 md:px-8 lg:px-12 pt-20 md:pt-32 pb-10 md:pb-14 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <p class="text-sm uppercase tracking-widest text-brand-primary font-semibold">
          {hero.eyebrow}
        </p>
        <h1 class="mt-4 text-5xl md:text-6xl font-bold text-brand-ink leading-tight">
          {hero.heading}
        </h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-brand-body leading-relaxed" data-reveal>
          {hero.body}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <button
            type="button"
            data-open-modal={demoCta.modal}
            class="inline-flex items-center justify-center bg-brand-primary text-white font-semibold px-6 py-3 rounded-md hover:bg-brand-primary-dark transition"
          >
            {demoCta.label}
          </button>
          <a
            href={exploreCta.href}
            class="inline-flex items-center justify-center border-2 border-brand-primary text-brand-primary font-semibold px-6 py-3 rounded-md hover:bg-brand-primary hover:text-white transition"
          >
            {exploreCta.label}
          </a>
        </div>
      </div>
      <div class="hidden md:block"></div>
    </div>

    <!-- #2 — Guest-speaker promo (bottom of hero) -->
    <div class="relative z-[2] max-w-7xl mx-auto px-6 md:px-8 lg:px-12 pb-12 md:pb-16">
      <div class="rounded-2xl bg-slate-900/70 backdrop-blur-md border border-white/10 shadow-xl px-5 py-4 md:px-6 md:py-5 flex flex-col sm:flex-row items-center gap-4 md:gap-6">
        <img
          src={speakerEvent.photo.src}
          alt={speakerEvent.photo.alt}
          class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover border-2 border-white/30 shrink-0"
          loading="lazy"
        />
        <div class="flex-1 min-w-0 text-center sm:text-left">
          <p class="text-[11px] uppercase tracking-[0.18em] text-brand-cyan font-semibold">{speakerEvent.eyebrow}</p>
          <p class="mt-1 text-white font-bold text-base md:text-lg leading-snug">
            {speakerEvent.title}{speakerEvent.date ? ` · ${speakerEvent.date}` : ''}
          </p>
          <p class="mt-0.5 text-sm text-white/70">{speakerEvent.presentedByPrefix} {speakerEvent.presenter}</p>
        </div>
        {speakerEvent.url ? (
          <a
            href={speakerEvent.url}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-2 bg-white text-brand-primary font-semibold text-sm px-5 py-3 rounded-lg hover:bg-brand-cyan-soft transition-colors whitespace-nowrap"
          >
            {speakerEvent.linkLabel}
            <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ) : (
          <span class="shrink-0 inline-flex items-center gap-2 bg-white/30 text-white font-semibold text-sm px-5 py-3 rounded-lg whitespace-nowrap cursor-default" aria-disabled="true" title={speakerEvent.comingSoonTitle}>
            {speakerEvent.linkLabel}
          </span>
        )}
      </div>
    </div>
  </section>

  <!-- SECTION 1.5 — TRUSTED PARTNERS MARQUEE (white background, compact) -->
  <section class="relative overflow-hidden bg-white">
    <div class="tp-band">
      <div class="tp-stack">
        <p class="tp-eyebrow">{partners.eyebrow}</p>
        <div class="tp-marquee" data-tp-track></div>
      </div>
    </div>
  </section>

  <style is:global>
    .tp-band { position: relative; overflow: hidden; height: 210px; }
    @media (min-width: 768px) { .tp-band { height: 230px; } }
    .tp-stack { position: relative; height: 100%; display: flex; flex-direction: column; }
    .tp-eyebrow {
      flex: 0 0 auto;
      text-align: center; padding-top: 18px; padding-bottom: 6px;
      font-size: 14px; letter-spacing: .18em; text-transform: uppercase;
      color: #0F2350; font-weight: 700;
    }
    @media (min-width: 768px) { .tp-eyebrow { font-size: 15px; padding-top: 22px; } }
    .tp-marquee {
      flex: 1 1 auto;
      display: flex; align-items: center;
      position: relative;
      --gap: 64px; --duration: 42s;
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    }
    .tp-track { display: flex; align-items: center; gap: var(--gap); width: max-content; animation: tp-scroll var(--duration) linear infinite; }
    @keyframes tp-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .tp-logo {
      flex-shrink: 0; height: 120px; display: flex; align-items: center; gap: 18px; padding: 0 10px;
      color: #0F2350;
    }
    .tp-logo .tp-mark {
      height: 80px; min-width: 80px;
      border-radius: 14px;
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(15,35,80,0.12);
      display: grid; place-items: center;
      box-shadow: 0 6px 22px -10px rgba(15,35,80,0.3);
      overflow: hidden;
      padding: 8px 12px;
    }
    .tp-logo .tp-mark svg { width: 44px; height: 44px; }
    /* Real partner logos: drop the white box + shadow, normalize by height, multiply so they "float" on the white band */
    .tp-logo .tp-mark.is-img {
      height: auto; min-width: 0;
      background: transparent; border: 0; border-radius: 0;
      box-shadow: none; overflow: visible; padding: 0;
    }
    .tp-logo .tp-mark.is-img img {
      height: 80px; width: auto; max-width: none;
      object-fit: contain; display: block;
      filter: grayscale(1) contrast(1.1);
      mix-blend-mode: multiply;
    }
    .tp-logo .tp-name { font-weight: 700; font-size: 18px; letter-spacing: -0.01em; white-space: nowrap; }
    .tp-logo .tp-name small {
      display: block; font-weight: 500; font-size: 11px; color: #64748B;
      letter-spacing: .04em; text-transform: uppercase; margin-top: 2px;
    }
    @media (prefers-reduced-motion: reduce) { .tp-track { animation: none; } }
  </style>

  <script is:inline define:vars={{ partners: partners.logos }}>
    (function () {
      // Built-in marks for partners without a logo file (PartnerIconSchema).
      var icons = {
        pulse: '<path d="M3 12h4l3-9 4 18 3-9h4"/>',
        hospital: '<path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-7h6v7"/>',
        cross: '<path d="M10 4h4v6h6v4h-6v6h-4v-6H4v-4h6z"/>',
        clinic: '<path d="M3 21h18M5 21V8l7-4 7 4v13M9 21v-5h6v5"/>'
      };
      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function buildLogo(p) {
        var imgStyle = p.scale ? ' style="height:' + Math.round(80 * p.scale) + 'px"' : '';
        var mark = p.logo
          ? '<img src="' + esc(p.logo.src) + '" alt="' + esc(p.logo.alt) + '" loading="lazy" decoding="async"' + imgStyle + '/>'
          : '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F2350" stroke-width="2">' + (icons[p.icon] || '') + '</svg>';
        var markClass = p.logo ? 'tp-mark is-img' : 'tp-mark';
        return '<div class="tp-logo">' +
          '<span class="' + markClass + '">' + mark + '</span>' +
          '<span class="tp-name">' + esc(p.name) + '<small>' + esc(p.tag) + '</small></span>' +
        '</div>';
      }
      document.querySelectorAll('[data-tp-track]').forEach(function (el) {
        var half = partners.map(buildLogo).join('');
        el.innerHTML = '<div class="tp-track">' + half + half + '</div>';
      });
    })();
  </script>

  <!-- SECTION 2 — VISION ("Beyond the Eye") — locked: hybrid full-bleed + multi-feather + soft wash + translucent panel -->
  <section class="relative bg-white overflow-hidden isolate py-10">
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <img
        src={beyondImage.src}
        alt={beyondImage.alt}
        class="absolute inset-0 w-full h-full object-cover object-center md:object-right"
        loading="lazy"
        style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);"
      />
    </div>
    <div
      class="absolute inset-0 z-[1] pointer-events-none"
      aria-hidden="true"
      style="background: linear-gradient(to right, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.78) 30%, rgba(255,255,255,0.35) 55%, rgba(255,255,255,0.10) 75%, rgba(255,255,255,0) 100%);"
    ></div>
    <div class="relative z-[2] max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28 grid md:grid-cols-2 gap-12 items-center">
      <div class="bg-white/[0.78] backdrop-blur-md border border-brand-line/70 rounded-2xl p-8 md:p-10 shadow-[0_10px_30px_-12px_rgba(15,44,92,0.12)]">
        <PipeHeading level="h2" data-reveal>{beyond.heading}</PipeHeading>
        <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
          {beyond.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
        </div>
      </div>
      <div class="hidden md:block"></div>
    </div>
  </section>

  <!-- SECTION 3 — FLAGSHIP (Ocula360 + Core Strengths) -->
  <section class="bg-brand-surface">
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div>
          <p class="text-xs uppercase tracking-widest text-brand-muted font-semibold">
            {flagship.eyebrow}
          </p>
          <p class="mt-1 text-sm text-brand-body">{flagship.tagline}</p>
        </div>
        <span class="self-start md:self-auto inline-block rounded-full bg-brand-primary text-white px-4 py-1.5 text-sm font-medium">
          {flagship.pill}
        </span>
      </div>

      <div class="grid gap-6 md:grid-cols-2" data-reveal-group>
        <!-- Flagship Card -->
        <div class="bg-white border border-brand-line rounded-2xl p-8 md:p-10 shadow-md">
          <p class="text-xs uppercase tracking-widest text-brand-primary-light font-semibold">
            {flagship.flagship.eyebrow}
          </p>
          <h2 class="mt-3 text-4xl font-bold text-brand-ink">{flagship.flagship.heading}</h2>
          <p class="mt-4 text-3xl font-bold text-brand-primary leading-tight">
            {flagship.flagship.subheading}
          </p>
          <p class="mt-5 text-base text-brand-body leading-relaxed">
            {flagshipLead}
          </p>
          <p class="mt-4 text-base text-brand-body leading-relaxed">
            {flagshipMore}
          </p>
          <a
            href={flagship.flagship.link.href}
            class="mt-6 inline-flex items-center gap-2 text-brand-primary font-semibold hover:gap-3 transition-all"
          >
            {flagship.flagship.link.label}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Core Strengths Card -->
        <div class="relative rounded-2xl p-8 md:p-10 overflow-hidden bg-gradient-to-br from-[#0F2C5C] via-[#123F6E] to-[#0F6F7D] text-white">
          <p class="text-xs uppercase tracking-widest text-brand-secondary font-semibold">
            {flagship.highlight.eyebrow}
          </p>
          <p class="mt-3 text-3xl font-bold leading-tight">
            {flagship.highlight.heading}
          </p>
          <p class="mt-5 text-base text-white/80 leading-relaxed">
            {flagship.highlight.body}
          </p>
        </div>
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-3" data-reveal-group>
        <CapabilityTile
          title={tileDetect.title}
          body={tileDetect.body}
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/>
            <path d="M14.5 2a2.5 2.5 0 0 0-2.5 2.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/>
          </svg>
        </CapabilityTile>
        <CapabilityTile
          title={tileDrss.title}
          body={tileDrss.body}
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18"/>
            <path d="M7 16V9"/>
            <path d="M12 16v-5"/>
            <path d="M17 16v-3"/>
          </svg>
        </CapabilityTile>
        <CapabilityTile
          title={tileExplain.title}
          body={tileExplain.body}
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </svg>
        </CapabilityTile>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — PRODUCT ECOSYSTEM (2x2 grid w/ product imagery) -->
  <section id="products" class="bg-white scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="text-center max-w-3xl mx-auto mb-14" data-reveal>
        <PipeHeading level="h2">{products.heading}</PipeHeading>
        <p class="mt-4 text-lg text-brand-body leading-relaxed">
          {products.intro}
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2" data-reveal-group>
        <!-- Ocula360 (flagship) -->
        <article class="group bg-white border border-brand-line rounded-2xl shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-shadow">
          <div class="relative aspect-[16/10] bg-brand-surface-blue overflow-hidden">
            <img
              src={ocula.image.src}
              alt={ocula.image.alt}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 inline-block rounded-full bg-brand-primary text-white text-[10px] font-semibold uppercase tracking-widest px-2.5 py-1 shadow">
              {ocula.badge}
            </span>
          </div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="text-2xl font-bold text-brand-ink">{ocula.title}</h3>
            <p class="mt-2 text-sm font-semibold text-brand-primary">
              {ocula.subtitle}
            </p>
            <p class="mt-3 text-sm text-brand-body leading-relaxed">
              {ocula.body}
            </p>
            <ul class="mt-4 space-y-1.5 text-sm text-brand-body">
              {ocula.bullets.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-2"><span class="text-brand-primary mt-0.5">•</span><span>{b}</span></li></Fragment>)}
            </ul>
            <a
              href={ocula.link.href}
              class="mt-auto pt-5 inline-flex items-center gap-2 text-brand-primary font-semibold group-hover:gap-3 transition-all"
            >
              {ocula.link.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- Nsight360 -->
        <article class="group bg-white border border-brand-line rounded-2xl shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-shadow">
          <div class="relative aspect-[16/10] bg-brand-surface-blue overflow-hidden">
            <img
              src={nsight.image.src}
              alt={nsight.image.alt}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="text-2xl font-bold text-brand-ink">{nsight.title}</h3>
            <p class="mt-2 text-sm font-semibold text-brand-primary">
              {nsight.subtitle}
            </p>
            <p class="mt-3 text-sm text-brand-body leading-relaxed">
              {nsight.body}
            </p>
            <ul class="mt-4 space-y-1.5 text-sm text-brand-body">
              {nsight.bullets.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-2"><span class="text-brand-primary mt-0.5">•</span><span>{b}</span></li></Fragment>)}
            </ul>
            <a
              href={nsight.link.href}
              class="mt-auto pt-5 inline-flex items-center gap-2 text-brand-primary font-semibold group-hover:gap-3 transition-all"
            >
              {nsight.link.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- 2nd Opinion -->
        <article class="group bg-white border border-brand-line rounded-2xl shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-shadow">
          <div class="relative aspect-[16/10] bg-brand-surface-blue overflow-hidden">
            <img
              src={secondOpinion.image.src}
              alt={secondOpinion.image.alt}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="text-2xl font-bold text-brand-ink">{secondOpinion.title}</h3>
            <p class="mt-2 text-sm font-semibold text-brand-primary">
              {secondOpinion.subtitle}
            </p>
            <p class="mt-3 text-sm text-brand-body leading-relaxed">
              {secondOpinion.body}
            </p>
            <ul class="mt-4 space-y-1.5 text-sm text-brand-body">
              {secondOpinion.bullets.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-2"><span class="text-brand-primary mt-0.5">•</span><span>{b}</span></li></Fragment>)}
            </ul>
            <a
              href={secondOpinion.link.href}
              class="mt-auto pt-5 inline-flex items-center gap-2 text-brand-primary font-semibold group-hover:gap-3 transition-all"
            >
              {secondOpinion.link.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- Ophthal360 -->
        <article class="group bg-white border border-brand-line rounded-2xl shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-shadow">
          <div class="relative aspect-[16/10] bg-brand-surface-blue overflow-hidden">
            <img
              src={ophthal.image.src}
              alt={ophthal.image.alt}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="p-7 flex flex-col flex-1">
            <h3 class="text-2xl font-bold text-brand-ink">{ophthal.title}</h3>
            <p class="mt-2 text-sm font-semibold text-brand-primary">
              {ophthal.subtitle}
            </p>
            <p class="mt-3 text-sm text-brand-body leading-relaxed">
              {ophthal.body}
            </p>
            <ul class="mt-4 space-y-1.5 text-sm text-brand-body">
              {ophthal.bullets.map((b, i) => <Fragment>{i > 0 && ' '}<li class="flex gap-2"><span class="text-brand-primary mt-0.5">•</span><span>{b}</span></li></Fragment>)}
            </ul>
            <a
              href={ophthal.link.href}
              class="mt-auto pt-5 inline-flex items-center gap-2 text-brand-primary font-semibold group-hover:gap-3 transition-all"
            >
              {ophthal.link.label}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <div class="mt-12 flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-xs text-brand-muted">
        {products.footnotes?.map((note, i) => <Fragment>{i > 0 && ' '}<span>{note}</span></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 5 — WHO WE HELP -->
  <section class="bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <PipeHeading level="h2" data-reveal>{whoWeHelp.heading}</PipeHeading>
      <p class="mt-4 max-w-3xl text-lg text-brand-body leading-relaxed" data-reveal>
        {whoWeHelp.intro}
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        <AudienceCard
          title={audPrimary.title}
          body={audPrimary.body}
        >
          <img
            slot="icon"
            src={audPrimary.image.src}
            alt={audPrimary.image.alt}
            width="96"
            height="96"
            class="w-full h-full object-contain"
            loading="lazy"
            decoding="async"
          />
        </AudienceCard>
        <AudienceCard
          title={audOptometry.title}
          body={audOptometry.body}
        >
          <img
            slot="icon"
            src={audOptometry.image.src}
            alt={audOptometry.image.alt}
            width="96"
            height="96"
            class="w-full h-full object-contain"
            loading="lazy"
            decoding="async"
          />
        </AudienceCard>
        <AudienceCard
          title={audInsurance.title}
          body={audInsurance.body}
        >
          <img
            slot="icon"
            src={audInsurance.image.src}
            alt={audInsurance.image.alt}
            width="96"
            height="96"
            class="w-full h-full object-cover rounded-full"
            loading="lazy"
            decoding="async"
          />
        </AudienceCard>
        <AudienceCard
          title={audPharma.title}
          body={audPharma.body}
        >
          <img
            slot="icon"
            src={audPharma.image.src}
            alt={audPharma.image.alt}
            width="96"
            height="96"
            class="w-full h-full object-contain"
            loading="lazy"
            decoding="async"
          />
        </AudienceCard>
      </div>
    </div>
  </section>

  <!-- SECTION 6 — TESTIMONIALS -->
  <CtaBand image={testimonial.image.src}>
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white" data-reveal>
        {testimonial.heading}
      </h2>
      <p class="mt-4 max-w-3xl mx-auto text-lg text-white/80 leading-relaxed" data-reveal>
        {testimonial.body}
      </p>
      <div class="mt-12" data-reveal>
        <TestimonialFeature
          quote={testimonial.quote}
          author={testimonial.author}
        />
      </div>
    </div>
  </CtaBand>

  <!-- SECTION 7 — LATEST RESOURCES -->
  <section class="bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-24">
      <PipeHeading level="h2" data-reveal>{insights.heading}</PipeHeading>
      <p class="mt-4 max-w-3xl text-lg text-brand-body leading-relaxed" data-reveal>
        {insights.intro}
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal-group>
        {insights.cards.map((card, i) => <Fragment>{i > 0 && ' '}<ResourceCard
          categoryColor={card.categoryColor}
          category={card.category}
          title={card.title}
          excerpt={card.excerpt}
          link={card.href}
          thumbnail={card.thumbnail?.src}
        /></Fragment>)}
      </div>

      <div class="mt-10 text-center">
        <a
          href={insightsLink.href}
          class="inline-flex items-center gap-2 text-brand-primary font-semibold hover:underline"
        >
          {insightsLink.label}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 8 — CLOSING -->
  <section class="bg-brand-surface-blue">
    <div class="max-w-3xl mx-auto px-6 md:px-8 lg:px-12 py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-ink leading-tight" data-reveal>
        {closing.heading}
      </h2>
      <div class="mt-6 space-y-5 text-lg text-brand-body leading-relaxed" data-reveal>
        {closing.paragraphs.map((p, i) => <Fragment>{i > 0 && ' '}<p>{p}</p></Fragment>)}
      </div>
    </div>
  </section>

  <!-- SECTION 9 — FINAL CTA -->
  <CtaBand image={finalCta.image?.src}>
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-20 md:py-28 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white leading-tight" data-reveal>
        {finalCta.heading}
      </h2>
      <div class="mt-8" data-reveal>
        <button
          type="button"
          data-open-modal={contactCta.modal}
          class="inline-flex items-center justify-center bg-white text-brand-primary font-semibold px-8 py-3 rounded-md hover:bg-brand-surface transition"
        >
          {contactCta.label}
        </button>
      </div>
      <p class="mt-8 text-sm text-white/80">
        <Fragment set:html={finalCta.note} />
      </p>
    </div>
  </CtaBand>

</Layout>
