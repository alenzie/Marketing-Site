---
interface MetaItem { k: string; v: string }
interface Props {
  title: string;
  lede: string;
  meta: MetaItem[];
  crumb?: string;
}
const { title, lede, meta, crumb } = Astro.props;
---

<section class="bg-brand-surface-blue border-b border-brand-line">
  <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-8 lg:py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-brand-muted flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-brand-primary">Home</a>
      <span>/</span>
      {crumb ? <a href="/trust" class="hover:text-brand-primary">Trust Center</a> : <span class="text-brand-ink">Trust Center</span>}
      {crumb && <span>/</span>}
      {crumb && <span class="text-brand-ink">{crumb}</span>}
    </nav>

    <div class="mt-4 lg:mt-5 flex flex-col lg:flex-row lg:flex-wrap lg:items-end lg:justify-between gap-6">
      <div class="max-w-[760px]">
        <h1 class="m-0 text-[30px] lg:text-[44px] font-bold leading-[1.12] tracking-[-0.02em] text-brand-ink">
          {title}
        </h1>
        <p class="mt-[18px] text-base lg:text-[17px] leading-[1.65] text-brand-body text-pretty">
          {lede}
        </p>
      </div>
      <a
        href="mailto:support@ophthalytics.com?subject=Security%20Documentation%20Request"
        class="w-full lg:w-auto inline-flex items-center justify-center gap-2 bg-brand-primary text-white text-sm font-semibold px-5 py-[15px] lg:py-[13px] rounded-lg hover:bg-brand-primary-dark transition-colors whitespace-nowrap"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2"></rect>
          <path d="M7 11V7a5 5 0 0110 0v4"></path>
        </svg>
        Request Documents
      </a>
    </div>

    <dl class="mt-7 lg:mt-9 m-0 grid grid-cols-2 lg:grid-cols-5 border border-slate-300 rounded-[10px] overflow-hidden bg-white">
      {meta.map((m, i) => (
        <div
          class:list={[
            'px-[18px] py-[14px]',
            i % 2 === 0 ? 'border-r border-brand-line' : '',
            'lg:border-r lg:border-brand-line lg:last:border-r-0',
            i < meta.length - (meta.length % 2 === 0 ? 2 : 1) ? 'border-b border-brand-line lg:border-b-0' : '',
          ]}
        >
          <dt class="font-mono text-[10px] uppercase tracking-[.16em] text-brand-muted">{m.k}</dt>
          <dd class="m-0 mt-[5px] text-sm font-semibold text-brand-ink leading-[1.35]">{m.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
