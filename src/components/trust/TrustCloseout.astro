---
// Close-out block. Deliberately NOT the header "Contact" button: that one is the
// customer/sales path and stays untouched. This is the security-team path, and it
// only appears at the foot of a Trust Center article.
---

<div class="mt-8 lg:mt-14 border-t border-brand-line text-center py-9 lg:py-11 lg:px-8">
  <h2 class="m-0 text-[22px] font-bold tracking-[-0.015em] text-brand-ink">
    Have any further questions?
  </h2>
  <p class="mt-3 mx-auto max-w-[520px] text-base leading-[1.7] text-brand-body text-pretty">
    Feel free to reach out to us — our security team reads every message, and we would
    rather answer a question twice than leave it unanswered once.
  </p>
  <div class="mt-[26px] flex flex-col sm:flex-row flex-wrap justify-center gap-[14px]">
    <a
      href="mailto:support@ophthalytics.com?subject=Trust%20Center%20Inquiry"
      class="inline-flex items-center justify-center gap-[9px] bg-brand-navy text-white text-[15px] font-semibold px-6 py-[14px] rounded-[10px] hover:bg-brand-primary transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      Contact support
    </a>
    <a
      href="mailto:support@ophthalytics.com?subject=Vulnerability%20Report"
      class="inline-flex items-center justify-center gap-[9px] bg-white text-brand-primary border border-slate-300 text-[15px] font-semibold px-6 py-[14px] rounded-[10px] hover:bg-brand-surface-blue transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      Report a vulnerability
    </a>
  </div>
</div>
